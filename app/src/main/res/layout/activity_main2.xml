<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F4F6FA"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SHAKE DETECTOR"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#263A60"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SỐ LẦN LẮC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#777777"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:text="0"
        android:textSize="76sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvBest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kỷ lục: 0"
        android:textSize="17sp"
        android:textColor="#E67E22"
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CƯỜNG ĐỘ CHUYỂN ĐỘNG"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#333333"/>

    <ProgressBar
        android:id="@+id/progressIntensity"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#3F51B5"
        android:progressBackgroundTint="#D5DCE8"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvIntensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cường độ: Chưa có"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:gravity="center"
        android:layout_marginBottom="25dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa bắt đầu"
        android:textSize="15sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Bắt đầu"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3F51B5"/>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Reset"
        android:textSize="17sp"
        android:layout_marginTop="12dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E67E22"/>

</LinearLayout>
